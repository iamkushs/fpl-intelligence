# FPL Intelligence - Environment Variable Template
# SAFE TO COMMIT. Copy to .env and fill secrets there.

APP_ENV=development
APP_NAME=fpl-intelligence
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

POSTGRES_ADMIN_HOST=127.0.0.1
POSTGRES_ADMIN_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

POSTGRES_DB=fpl_intelligence
POSTGRES_USER=fpl_app
POSTGRES_PASSWORD=
DATABASE_URL=
# Standard Neon URLs are accepted, for example:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CODEX_APP_SERVER_COMMAND=codex app-server --stdio
CODEX_DEFAULT_MODEL=
CODEX_DEFAULT_REASONING_EFFORT=
CODEX_TIMEOUT_SECONDS=180
CODEX_WORKING_DIRECTORY=

OFFICIAL_FPL_BASE_URL=https://fantasy.premierleague.com/api
OFFICIAL_FPL_TIMEOUT_SECONDS=15
OFFICIAL_FPL_SEASON_ID=

SEARCH_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

ANALYTICS_PROVIDER=disabled

OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=state/storage

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Symphony GitHub tracker integration (set outside the repository).
GITHUB_TOKEN=
SYMPHONY_WORKSPACE_ROOT=/tmp/fpl-intelligence-symphony
SYMPHONY_SOURCE_DIR=
